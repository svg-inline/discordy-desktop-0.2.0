# Discordy 0.5.0 — exemplo Coturn
# Copie para /etc/turnserver.conf e ajuste domínio, IP público e credenciais.

listening-port=3478
tls-listening-port=5349
fingerprint
lt-cred-mech
realm=turn.example.com
server-name=turn.example.com

# MVP: credencial estática. Substitua antes de expor o servidor.
user=discordy:CHANGE_ME_STRONG_PASSWORD

# Se o Coturn estiver atrás de NAT, configure o IP público/mapeamento conforme sua infraestrutura.
# external-ip=203.0.113.10

# TLS para turns:. Descomente após instalar certificados válidos.
# cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
# pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem

no-multicast-peers
no-cli
stale-nonce=600

# Faixa de portas relay. Libere UDP no firewall.
min-port=49160
max-port=49200

# Para credenciais temporárias em uma versão futura do Discordy:
# use-auth-secret
# static-auth-secret=CHANGE_ME_RANDOM_SECRET
# Não habilite junto com user= sem revisar a estratégia de autenticação.
