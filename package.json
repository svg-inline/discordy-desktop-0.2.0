{
  "name": "discordy-desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Discordy Desktop - UI Foundation estilo Discord para salas WebRTC P2P auto-hospedadas",
  "main": "electron/main.mjs",
  "author": "Discordy",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.1",
    "cross-env": "10.0.0",
    "electron": "43.4.0",
    "electron-builder": "26.0.12",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "wait-on": "8.0.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "dev.discordy.desktop",
    "productName": "Discordy",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Discordy Invite",
        "schemes": [
          "discordy"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Discordy-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "release"
    }
  }
}
