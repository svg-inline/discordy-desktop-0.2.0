# 0.5.0 — STUN / TURN / Connectivity
# Valores separados por vírgula. A UI do Discordy pode sobrescrever estes defaults em runtime.
VITE_ICE_MODE=auto
VITE_STUN_URLS=stun:stun.l.google.com:19302

# Coturn / TURN opcional.
# Exemplos:
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Compatibilidade com versões anteriores. Use VITE_STUN_URLS em novas instalações.
VITE_STUN_URL=
